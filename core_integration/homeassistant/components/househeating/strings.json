{
  "title": "HouseHeating Modbus",
  "config": {
    "step": {
      "user": {
        "title": "HouseHeating Modbus",
        "description": "Experimental HH-C3-12 integration. Starts without writing. For TCP enter host/port; for USB/RS485 enter the serial device. Configure the heat-pump gateway/UART for 9600 baud, 8N1 and RTU. Do not add an independent second master on the same bus.",
        "data": {
          "name": "Device name",
          "transport": "Connection type",
          "host": "Gateway IP address or hostname",
          "port": "TCP port",
          "serial_device": "USB/RS485 serial device",
          "unit_id": "Modbus unit ID"
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "description": "Keep the existing device and entities. Control is locked again.",
        "data": {
          "name": "Device name",
          "transport": "Connection type",
          "host": "Gateway IP address or hostname",
          "port": "TCP port",
          "serial_device": "USB/RS485 serial device",
          "unit_id": "Modbus unit ID"
        }
      }
    },
    "error": {
      "cannot_connect": "No usable Modbus response. Check wiring, framing, unit ID and logs.",
      "invalid_connection": "Invalid connection details or an incompatible register layout.",
      "invalid_options": "Check the configuration value ranges.",
      "commissioning_failed": "Commissioning failed. Check temperature divisors, readable firmware/protocol and all four setpoints. Save with control disabled first and review diagnostics.",
      "confirmation_required": "Confirm the comparison with the physical controller first."
    },
    "abort": {
      "reconfigure_successful": "Connection updated; authorize control again."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling and control",
        "description": "Start with control disabled. The manual specifies raw/10 temperatures. Only use raw/1 after checking the physical controller. Measurements and setpoints have separate divisors. Extra entities can be enabled in the entity list.",
        "data": {
          "scan_interval": "Basic polling interval (seconds)",
          "slow_interval": "Extra registers interval (seconds)",
          "measurement_divisor": "Measured temperature divisor",
          "setpoint_divisor": "Setpoint temperature divisor",
          "max_read": "Maximum registers per request",
          "spacing_ms": "Minimum bus quiet time (milliseconds)",
          "timeout": "Minimum request timeout (seconds)",
          "extended": "Read extra register groups",
          "curves": "Read native curve registers",
          "max_heating": "Maximum allowed heating setpoint (°C)",
          "max_floor": "Maximum allowed floor-heating setpoint (°C)",
          "max_dhw": "Maximum allowed hot-water setpoint (°C)",
          "allow_control": "Enable Modbus control after confirmation"
        }
      },
      "confirm_control": {
        "title": "Check the actual readings",
        "description": "Compare the following values with the physical controller. Confirmation does NOT send any command; it enables the controls afterwards. This is not a hardware or safety certification.\n\n{readings}",
        "data": {
          "confirm_values": "I compared every displayed temperature and setpoint with the physical controller and verified the installation is ready for these commands"
        }
      }
    },
    "error": {
      "cannot_connect": "No usable Modbus response. Check wiring, framing, unit ID and logs.",
      "invalid_connection": "Invalid connection details or an incompatible register layout.",
      "invalid_options": "Check the configuration value ranges.",
      "commissioning_failed": "Commissioning failed. Check temperature divisors, readable firmware/protocol and all four setpoints. Save with control disabled first and review diagnostics.",
      "confirmation_required": "Confirm the comparison with the physical controller first."
    }
  },
