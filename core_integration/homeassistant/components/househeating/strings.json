{
  "title": "HouseHeating Modbus",
  "config": {
    "step": {
      "user": {
        "title": "HouseHeating Modbus",
        "description": "Experimental HH-C3-12 integration. Starts without writing. For TCP enter host/port; for USB/RS485 enter the serial device. Configure the heat-pump gateway/UART for 9600 baud, 8N1 and RTU. Do not add an independent second master on the same bus. Select temperature divisors against the physical controller: raw 350 for 35 °C = divisor 10; raw 35 for 35 °C = divisor 1. Measurements and setpoints may differ. Control stays locked until readings are confirmed in the options.",
        "data": {
          "name": "Device name",
          "transport": "Connection type",
          "host": "Gateway IP address or hostname",
          "port": "TCP port",
          "serial_device": "USB/RS485 serial device",
          "unit_id": "Modbus unit ID",
          "measurement_divisor": "Measured temperature divisor",
          "setpoint_divisor": "Setpoint temperature divisor"
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "description": "Keep the existing device and entities. Control is locked again.",
        "data": {
          "name": "Device name",
          "transport": "Connection type",
          "host": "Gateway IP address or hostname",
          "port": "TCP port",
          "serial_device": "USB/RS485 serial device",
          "unit_id": "Modbus unit ID",
          "measurement_divisor": "Measured temperature divisor",
          "setpoint_divisor": "Setpoint temperature divisor"
        }
      }
